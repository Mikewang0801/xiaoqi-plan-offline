{
  "name": "xiaoqi-plan-offline",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode offline",
    "build": "tsc --noEmit && vite build --mode offline",
    "android": "npm run build && cap sync android",
    "ios": "npm run build && cap sync ios",
    "android:debug": "powershell -ExecutionPolicy Bypass -File ./构建离线版.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/local-notifications": "8.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
